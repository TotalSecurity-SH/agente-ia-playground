# Sin llaves, en Vercel el agente usa AI Gateway con el token OIDC del proyecto (crédito gratuito mensual).
# Si la IA no responde, cae a modo demostración (respuestas por reglas).
AI_GATEWAY_API_KEY=
# O una llave directa del proveedor:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: forzar proveedor (openai | anthropic) y modelo.
LLM_PROVIDER=
LLM_MODEL=
# Mensajes por IP cada 10 minutos (por instancia). Controla el gasto.
AGENTE_LIMITE=30
# 1 = forzar modo demostración aunque haya llave.
AGENTE_DEMO=
