ANTHROPIC_API_KEY=
# Opcional: forzar proveedor (openai | anthropic) y modelo.
LLM_PROVIDER=
LLM_MODEL=
# Mensajes por IP cada 10 minutos (por instancia). Controla el gasto.
AGENTE_LIMITE=30
# 1 = forzar modo demostración aunque haya llave.
AGENTE_DEMO=
